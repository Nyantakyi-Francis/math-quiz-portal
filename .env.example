# Public app URL used for auth redirects, robots, sitemap, and metadata.
# Use http://localhost:3000 locally and your real HTTPS URL in production.
SITE_URL=http://localhost:3000

# Optional public fallback for metadata in hosts that cannot set SITE_URL.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional email notifications when a new message is received (uses Resend).
# Set ENABLE_MESSAGE_EMAIL_NOTIFICATIONS=1 to enable.
ENABLE_MESSAGE_EMAIL_NOTIFICATIONS=0
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_NOTIFICATIONS_MAX_RECIPIENTS=20
