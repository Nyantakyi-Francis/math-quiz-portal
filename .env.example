# Local development URL. On Vercel, the app can infer the deployment URL automatically.
SITE_URL=http://localhost:3000

# Optional legacy fallback for older configs. Leave blank in Vercel unless you need it.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional email notifications when a new message is received (uses Resend).
# Set ENABLE_MESSAGE_EMAIL_NOTIFICATIONS=1 to enable.
ENABLE_MESSAGE_EMAIL_NOTIFICATIONS=0
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_NOTIFICATIONS_MAX_RECIPIENTS=20
